generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model InstagramAccount {
  id             String             @id @default(uuid()) @db.Uuid
  professionalId String             @unique
  appScopedId    String?
  label          String
  connectionGeneration Int          @default(0)
  webhookAppAlias String?
  webhookGeneration Int?
  webhookFields String[]             @default([])
  pausedAt       DateTime?            @db.Timestamptz(3)
  credential     AccountCredential?
  contacts       Contact[]
  conversations  Conversation[]
  messages       Message[]
  inboundEvents  InboundEvent[]
  oauthStates    MetaOAuthState[]
  automations    Automation[]
  deliveryIntents DeliveryIntent[]
  deliveryAttempts DeliveryAttempt[]
  syntheticEffects SyntheticEffect[]
  limit          AccountLimit?
  heartbeats     WorkerHeartbeat[]
}

model AccountCredential {
  accountId   String           @id @db.Uuid
  ciphertext  Bytes
  keyVersion  Int
  generation  Int              @default(1)
  scopes      String[]         @default([])
  issuedAt    DateTime?        @db.Timestamptz(3)
  expiresAt   DateTime?        @db.Timestamptz(3)
  revokedAt   DateTime?        @db.Timestamptz(3)
  refreshLease String?         @db.Uuid
  refreshLeasedUntil DateTime?  @db.Timestamptz(3)
  account     InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Contact {
  accountId      String           @db.Uuid
  id             String           @default(uuid()) @db.Uuid
  igScopedUserId String
  suppressedAt  DateTime?            @db.Timestamptz(3)
  account        InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversations  Conversation[]

  @@id([accountId, id])
  @@unique([accountId, igScopedUserId])
}

model Conversation {
  accountId String           @db.Uuid
  id        String           @default(uuid()) @db.Uuid
  contactId String           @db.Uuid
  control   String           @default("automatic")
  controlVersion Int         @default(0)
  status    String           @default("open")
  note      String?
  lastEligibleInboundAt DateTime? @db.Timestamptz(3)
  account   InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact   Contact          @relation(fields: [accountId, contactId], references: [accountId, id], onDelete: Cascade)
  messages  Message[]
  intents   DeliveryIntent[]

  @@id([accountId, id])
}

model Message {
  accountId      String           @db.Uuid
  id             String           @default(uuid()) @db.Uuid
  conversationId String           @db.Uuid
  externalId     String
  body           String?
  direction      String           @default("inbound")
  kind           String           @default("text")
  echo           Boolean          @default(false)
  occurredAt     DateTime          @default(now()) @db.Timestamptz(3)
  receivedAt     DateTime          @default(now()) @db.Timestamptz(3)
  account        InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversation   Conversation     @relation(fields: [accountId, conversationId], references: [accountId, id], onDelete: Cascade)

  @@id([accountId, id])
  @@unique([accountId, externalId])
}

model InboundEvent {
  accountId  String           @db.Uuid
  id         String           @default(uuid()) @db.Uuid
  externalId String
  kind       String           @default("foundation")
  generation Int              @default(0)
  occurredAt DateTime         @default(now()) @db.Timestamptz(3)
  receivedAt DateTime         @default(now()) @db.Timestamptz(3)
  payload    Json?
  processedAt DateTime?
  account    InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  intents    DeliveryIntent[]

  @@id([accountId, id])
  @@unique([accountId, externalId])
}

// Better Auth: identidade do operador independente das contas Instagram.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthStates MetaOAuthState[]
  @@index([userId])
}

model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String   @unique
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model LocalOAuthGrant {
  codeHash      String   @id
  subject       String
  challenge     String
  redirectURI   String
  expiresAt     DateTime @db.Timestamptz(3)
}

model MetaOAuthState {
  stateHash  String   @id
  accountId  String   @db.Uuid
  sessionId  String
  generation Int
  scopes     String[]
  expiresAt  DateTime @db.Timestamptz(3)
  account    InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([accountId])
  @@index([sessionId])
}

model Automation {
  accountId String @db.Uuid
  id String @default(uuid()) @db.Uuid
  name String
  trigger String @default("comment")
  mediaId String?
  status String @default("draft")
  revision Int @default(1)
  config Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  intents DeliveryIntent[]
  @@id([accountId, id])
}

model DeliveryIntent {
  accountId String @db.Uuid
  id String @default(uuid()) @db.Uuid
  conversationId String @db.Uuid
  eventId String? @db.Uuid
  automationId String? @db.Uuid
  automationRevision Int?
  controlVersion Int
  connectionGeneration Int
  source String
  effect String
  idempotencyKey String
  status String @default("pending")
  body Json
  deadline DateTime @db.Timestamptz(3)
  nextAttemptAt DateTime? @db.Timestamptz(3)
  reservedUntil DateTime? @db.Timestamptz(3)
  acceptedId String?
  reason String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [accountId, conversationId], references: [accountId, id], onDelete: Cascade)
  event InboundEvent? @relation(fields: [accountId, eventId], references: [accountId, id])
  automation Automation? @relation(fields: [accountId, automationId], references: [accountId, id])
  attempts DeliveryAttempt[]
  syntheticEffects SyntheticEffect[]
  @@id([accountId, id])
  @@unique([accountId, idempotencyKey])
  @@index([accountId, status, nextAttemptAt])
}

model DeliveryAttempt {
  accountId String @db.Uuid
  id String @default(uuid()) @db.Uuid
  intentId String @db.Uuid
  number Int
  status String @default("started")
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  endedAt DateTime? @db.Timestamptz(3)
  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  intent DeliveryIntent @relation(fields: [accountId, intentId], references: [accountId, id], onDelete: Cascade)
  effects SyntheticEffect[]
  @@id([accountId, id])
  @@unique([accountId, intentId, number])
}

model SyntheticEffect {
  accountId String @db.Uuid
  id String @default(uuid()) @db.Uuid
  intentId String @db.Uuid
  attemptId String @db.Uuid
  acceptedAt DateTime @default(now()) @db.Timestamptz(3)
  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  intent DeliveryIntent @relation(fields: [accountId, intentId], references: [accountId, id], onDelete: Cascade)
  attempt DeliveryAttempt @relation(fields: [accountId, attemptId], references: [accountId, id], onDelete: Cascade)
  @@id([accountId, id])
}

model AccountLimit {
  accountId String @id @db.Uuid
  quota Int @default(30)
  used Int @default(0)
  windowStartedAt DateTime @default(now()) @db.Timestamptz(3)
  cooldownUntil DateTime? @db.Timestamptz(3)
  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model WorkerHeartbeat {
  accountId String @db.Uuid
  kind String
  seenAt DateTime @db.Timestamptz(3)
  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@id([accountId, kind])
}
