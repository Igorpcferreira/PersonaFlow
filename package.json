{
  "name": "personaflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "demo:stop": "tsx scripts/demo.ts --stop",
    "demo:seed": "tsx scripts/demo.ts --seed",
    "test:browser:install": "tsx scripts/install-browser.ts",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "test:restart": "tsx scripts/test-restart.ts",
    "setup": "tsx scripts/setup.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "worker:dev": "tsx src/jobs/worker.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:integration:external": "vitest run tests/integration --no-file-parallelism",
    "build": "next build",
    "check": "node node_modules/eslint/bin/eslint.js . && node node_modules/typescript/bin/tsc --noEmit && node node_modules/vitest/vitest.mjs run tests/unit"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.6",
    "dotenv": "17.2.3",
    "next": "16.3.6",
    "pg": "8.16.3",
    "pg-boss": "12.35.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "prisma": {
      "mysql2": "3.24.4"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.19.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
