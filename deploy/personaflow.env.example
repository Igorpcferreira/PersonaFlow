# Copie para ~/.config/personaflow/personaflow.env e use chmod 600.
# DATABASE_URL deve corresponder a postgres.env e permanecer em loopback.
DATABASE_URL=postgresql://personaflow_pilot:replace-with-a-random-secret@127.0.0.1:5432/personaflow_pilot

# O modo production impede a demonstração e o worker sintético. Envio deve ficar desabilitado.
PERSONAFLOW_MODE=production
PERSONAFLOW_BIND_HOST=127.0.0.1
PERSONAFLOW_SEND_MODE=disabled
# Ative meta-private-reply somente após o Reels, OAuth, webhook e teste controlado.

BETTER_AUTH_URL=https://personaflow.somoskyber.com.br
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
OPERATOR_ALLOWLIST=github:REPLACE_WITH_NUMERIC_OPERATOR_ID
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mantenha vazios até a configuração Meta ser deliberadamente validada.
PERSONAFLOW_TOKEN_KEY=
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_OAUTH_CALLBACK_URL=https://personaflow.somoskyber.com.br/api/meta/oauth/callback
META_INSTAGRAM_GRAPH_VERSION=
META_INSTAGRAM_PILOT_ACCOUNT_ID=
META_INSTAGRAM_PILOT_PROFESSIONAL_ID=
META_INSTAGRAM_PILOT_REEL_ID=
# ID numérico exato do único comentário controlado autorizado para o primeiro envio.
META_INSTAGRAM_TEST_COMMENT_ID=
META_WEBHOOK_APP_ALIAS=somoskyber-pilot
META_WEBHOOK_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
