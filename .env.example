# Copie para .env e substitua apenas por dados de um PostgreSQL local isolado.
DATABASE_URL=postgresql://persona_local:change-me@127.0.0.1:5432/personaflow_local
# Porta e dados de teste são gerados pelo executor de integração.
# Autenticação da demonstração: nunca habilitar local-demo em produção.
PERSONAFLOW_MODE=locked
PERSONAFLOW_BIND_HOST=127.0.0.1
BETTER_AUTH_URL=http://127.0.0.1:3000
# Segurança do adaptador Meta: permanece desativado, inclusive após conectar a conta.
PERSONAFLOW_SEND_MODE=disabled
# Gere localmente uma sequência aleatória com pelo menos 32 caracteres.
BETTER_AUTH_SECRET=
OPERATOR_ALLOWLIST=local-demo:demo-operator-001
# GitHub nesta etapa está configurado com placeholders e bloqueado no handler.
# Segredos exclusivos da simulação; o supervisor demo gera/preserva sem imprimir.
PERSONAFLOW_TOKEN_KEY=
PERSONAFLOW_WEBHOOK_SECRET=
PERSONAFLOW_WEBHOOK_VERIFY_TOKEN=
# OAuth real do piloto @somoskyber. Preencha somente em secret mount/arquivo local protegido.
# A URL é o callback HTTPS público exato, com path /api/meta/oauth/callback. Não há domínio padrão.
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_OAUTH_CALLBACK_URL=
# Defina após validar a versão aceita no painel/API; exemplos anteriores citaram v25.0.
META_INSTAGRAM_GRAPH_VERSION=
# UUID interno da conta piloto e Instagram User ID profissional esperado, nunca o username.
META_INSTAGRAM_PILOT_ACCOUNT_ID=
META_INSTAGRAM_PILOT_PROFESSIONAL_ID=
# Recepção de webhooks do mesmo app Meta. O accessor getMetaWebhookRuntime inicia somente fila e valida assinatura.
META_WEBHOOK_APP_ALIAS=somoskyber-pilot
META_WEBHOOK_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
